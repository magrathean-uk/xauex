[Unit]
Description=Run XAUEX post-trade journal after the London force-flat boundary

[Timer]
OnCalendar=Mon-Fri *-*-* 15:45:00 Europe/London
OnCalendar=Mon-Fri *-*-* 16:30:00 Europe/London
OnCalendar=Mon-Fri *-*-* 19:00:00 Europe/London
Persistent=true
Unit=xauex-trade-journal.service

[Install]
WantedBy=timers.target
