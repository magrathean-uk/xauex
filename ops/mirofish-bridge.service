[Unit]
Description=MiroFish Bridge Signal Refresh
After=network-online.target mirofish-backend.service xauex.service
Wants=network-online.target
Requires=mirofish-backend.service xauex.service

[Service]
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=__REPO_ROOT__/.env
Environment=PYTHONUNBUFFERED=1
Environment=LOG_LEVEL=DEBUG
ExecStart=__REPO_ROOT__/ops/run_bridge.sh
TimeoutStartSec=3600
StandardOutput=append:__REPO_ROOT__/logs/bridge-run.log
StandardError=append:__REPO_ROOT__/logs/bridge-run-error.log

[Install]
WantedBy=multi-user.target
