[Unit]
Description=MiroFish Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REPO_ROOT__/backend
EnvironmentFile=__REPO_ROOT__/.env
Environment=FLASK_DEBUG=false
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO_ROOT__/ops/run_backend.sh
Restart=always
RestartSec=10
StandardOutput=append:__REPO_ROOT__/logs/backend.log
StandardError=append:__REPO_ROOT__/logs/backend-error.log

[Install]
WantedBy=multi-user.target
