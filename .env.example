# XAUEX root environment
# Copy to .env and fill in real values.

# XAUEX signal LLM provider
XAUEX_SIGNAL_LLM_API_KEY=
XAUEX_SIGNAL_LLM_BASE_URL=https://api.groq.com/openai/v1
XAUEX_SIGNAL_LLM_MODEL=llama-3.1-8b-instant

# Optional separate parser model for final signal classification
XAUEX_SIGNAL_PARSER_LLM_API_KEY=
XAUEX_SIGNAL_PARSER_LLM_BASE_URL=https://api.groq.com/openai/v1
XAUEX_SIGNAL_PARSER_LLM_MODEL=openai/gpt-oss-120b

# Optional second-opinion validator for the final signal
XAUEX_SIGNAL_VALIDATOR_LLM_API_KEY=
XAUEX_SIGNAL_VALIDATOR_LLM_BASE_URL=https://api.groq.com/openai/v1
XAUEX_SIGNAL_VALIDATOR_LLM_MODEL=llama-3.3-70b-versatile

# Optional cheap brief-writer override for operator-facing prose
XAUEX_SIGNAL_BRIEF_LLM_API_KEY=
XAUEX_SIGNAL_BRIEF_LLM_BASE_URL=https://api.groq.com/openai/v1
XAUEX_SIGNAL_BRIEF_LLM_MODEL=llama-3.1-8b-instant

# Optional official CME FedWatch API hookup. Leave blank unless you have access.
XAUEX_SIGNAL_CME_FEDWATCH_API_URL=
XAUEX_SIGNAL_CME_FEDWATCH_API_KEY=
XAUEX_SIGNAL_CME_FEDWATCH_API_KEY_HEADER=Authorization

# Optional graph memory provider
ZEP_API_KEY=

# XAUEX signal runtime
SIGNAL_OUTPUT_PATH=/var/lib/xauex/cmd.json
XAUEX_SIGNAL_BRIEF_OUTPUT_PATH=/var/lib/xauex/latest_signal_brief.md
XAUEX_SIGNAL_EVIDENCE_OUTPUT_PATH=/var/lib/xauex/latest_signal_evidence.json
STATE_FILE_PATH=/var/lib/xauex/state.json
TRADE_JOURNAL_PATH=/var/lib/xauex/trade_journal.json
XAUEX_SIGNAL_REQUEST_TIMEOUT_SECONDS=180
XAUEX_SIGNAL_SOURCE_TIMEOUT_SECONDS=20
XAUEX_SIGNAL_PROJECT_PREFIX=XAUEX London Morning
XAUEX_SIGNAL_DAILY_COST_CAP_USD=0.20
XAUEX_SIGNAL_COST_LEDGER_PATH=/var/lib/xauex/signal_costs.jsonl

# Optional phase-2 memory layer (disabled unless configured)
QDRANT_ENABLED=1
QDRANT_PATH=/var/lib/xauex/qdrant_local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=xauex_signal_memory
QDRANT_TIMEOUT_SECONDS=10

# Optional compatibility aliases if older code paths still read them
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Optional XAUEX execution timing (Europe/London)
XAUEX_ENTRY_START_LONDON=08:00
XAUEX_ENTRY_END_LONDON=08:05
XAUEX_ENTRY_SECOND_START_LONDON=11:30
XAUEX_ENTRY_SECOND_END_LONDON=11:35
XAUEX_FORCE_FLAT_LONDON=15:00
XAUEX_MAX_TRADES_PER_DAY=2
