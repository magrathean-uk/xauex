# GoldOracle root environment
# Copy to .env and fill in real values.

# Backend / bridge LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.1-8b-instant

# Optional separate parser model for final signal classification
BRIDGE_PARSER_LLM_API_KEY=
BRIDGE_PARSER_LLM_BASE_URL=https://api.groq.com/openai/v1
BRIDGE_PARSER_LLM_MODEL=llama-3.3-70b-versatile

# Zep graph backend
ZEP_API_KEY=

# Backend service
FLASK_PORT=5001
MIROFISH_URL=http://127.0.0.1:5001

# Bridge runtime
BRIDGE_PREDICTION_MODE=direct
SIGNAL_OUTPUT_PATH=/var/lib/xauex/cmd.json
BRIDGE_BRIEF_OUTPUT_PATH=/var/lib/xauex/latest_signal_brief.md
BRIDGE_EVIDENCE_OUTPUT_PATH=/var/lib/xauex/latest_signal_evidence.json
STATE_FILE_PATH=/var/lib/xauex/state.json
TRADE_JOURNAL_PATH=/var/lib/xauex/trade_journal.json
BRIDGE_MAX_ROUNDS=18
BRIDGE_HISTORY_FALLBACK_LIMIT=20
BRIDGE_REQUEST_TIMEOUT_SECONDS=180
BRIDGE_SOURCE_TIMEOUT_SECONDS=20
BRIDGE_PROJECT_PREFIX=MiroFish London Morning

# Optional phase-2 memory layer (disabled unless configured)
QDRANT_ENABLED=1
QDRANT_PATH=/var/lib/xauex/qdrant_local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mirofish_oracle_memory
QDRANT_TIMEOUT_SECONDS=10

# Optional compatibility aliases if older code paths still read them
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
