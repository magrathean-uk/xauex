# cTrader Open API application credentials
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# cTrader connection
CTRADER_HOST=demo-uk-eqx-01.p.c-trader.com
CTRADER_PORT=5035
CTRADER_TLS_SERVER_NAME=connect.spotware.com

# Account
CTRADER_ACCOUNT_ID=

# OAuth tokens — populated by auth.py on first run
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_TOKEN_EXPIRY=

# Bot parameters
RISK_PERCENT=0.5
MAX_OPEN_TRADES=1
SL_OFFSET_DOLLARS=12.0
SL_MIN_DOLLARS=10.0
SL_MAX_DOLLARS=15.0
LEVEL_PROXIMITY_DOLLARS=3.0
EXECUTION_TIMEFRAME=H1
NEWS_BLOCK_MINUTES=30
WEEKLY_STOP_PCT=2.0
DAILY_STOP_PCT=1.0
MAX_CONSECUTIVE_LOSSES=2
MAX_LOT_SIZE=0.01
INSIDE_BAR_EXPIRY_CANDLES=3
SAME_LEVEL_COOLDOWN_CANDLES=4
ENABLE_EMA_PULLBACK_ENTRIES=true
EMA_PULLBACK_PROXIMITY_DOLLARS=2.5
STRATEGY_MODE=LEGACY_LEVELS
SHADOW_STRATEGY_MODE=SCALP_V1
ATR_PERIOD=14
EMA_PULLBACK_ATR_MULTIPLIER=1.0
EMA_PULLBACK_LOOKBACK_BARS=6
EMA_MIN_SEPARATION_ATR=0.2
EMA_MIN_SLOPE_DOLLARS=1.5
EMA_SLOPE_LOOKBACK=5
ATR_MIN_DOLLARS=6.0
SL_BUFFER_ATR_MULTIPLIER=0.5
SL_BUFFER_MIN_DOLLARS=3.0
SL_TOTAL_MIN_DOLLARS=10.0
EMA_PULLBACK_TAKE_PROFIT_RR=2.0
STRATEGY_MAX_TRADES_PER_DAY=1
STRATEGY_REENTRY_COOLDOWN_CANDLES=8
CONSOLIDATION_MIN_CANDLES=2
CONSOLIDATION_MAX_CANDLES=4
CONSOLIDATION_RANGE_ATR_MAX=0.6
MACRO_REGIME_PATH=/var/lib/xauex/macro_regime.json
MACRO_REGIME_MAX_AGE_MINUTES=180
MACRO_REGIME_CONFIDENCE_THRESHOLD=0.65
SCALP_FAST_EMA_PERIOD=9
SCALP_SLOW_EMA_PERIOD=20
SCALP_ATR_PERIOD=14
SCALP_PULLBACK_LOOKBACK_BARS=4
SCALP_PULLBACK_ATR_MULTIPLIER=0.25
SCALP_TOUCH_PROXIMITY_DOLLARS=1.5
SCALP_BODY_MIN_RATIO=0.45
SCALP_CLOSE_POSITION_THRESHOLD=0.35
SCALP_EMA_DISTANCE_ATR_MIN=0.05
SCALP_ATR_MIN_DOLLARS=3.0
SCALP_SPREAD_MAX_DOLLARS=0.8
SCALP_STOP_BUFFER_ATR_MULTIPLIER=0.35
SCALP_STOP_BUFFER_MIN_DOLLARS=1.5
SCALP_SL_MIN_DOLLARS=3.0
SCALP_SL_MAX_DOLLARS=12.0
SCALP_TAKE_PROFIT_RR=1.5
SCALP_MAX_TRADES_PER_DAY=4
SCALP_REENTRY_COOLDOWN_BARS=4

# CRITICAL: Set to true until manual demo trading proves edge
OBSERVE_ONLY=true

# Health check HTTP endpoint (GET /health)
HEALTH_CHECK_HOST=127.0.0.1
HEALTH_CHECK_PORT=8051

# Paths
STATE_FILE_PATH=/var/lib/xauex/state.json
CMD_FILE_PATH=/var/lib/xauex/cmd.json
LOG_FILE_PATH=/var/log/xauex/xauex.log

# XAUEX signal integration
XAUEX_MODE=true
XAUEX_SIGNAL_MAX_AGE_SECONDS=600
XAUEX_MAX_TRADES_PER_DAY=2
XAUEX_ENTRY_START_LONDON=08:00
XAUEX_ENTRY_END_LONDON=08:05
XAUEX_ENTRY_SECOND_START_LONDON=11:30
XAUEX_ENTRY_SECOND_END_LONDON=11:35
XAUEX_FORCE_FLAT_LONDON=15:00
XAUEX_CASH_TAKE_PROFIT_GBP=50
XAUEX_CASH_STOP_LOSS_GBP=50
XAUEX_RISK_CAP_PERCENT=1.0
XAUEX_CONFIDENCE_FULL_THRESHOLD=0.65
XAUEX_CONFIDENCE_MEDIUM_THRESHOLD=0.55
XAUEX_MEDIUM_CONFIDENCE_LOT_MULTIPLIER=0.5
XAUEX_LOW_CONFIDENCE_LOT_MULTIPLIER=0.25
XAUEX_SESSION_PROTECT_R=0.85
XAUEX_SESSION_TRAIL_R=1.35
XAUEX_SESSION_ATR_MULTIPLIER=1.4
XAUEX_SESSION_STRUCTURE_BUFFER_USD=2.5
XAUEX_SESSION_PROTECT_BUFFER_USD=1.0
XAUEX_SESSION_PROTECT_LOCK_R=0.30
XAUEX_SESSION_LOW_CONFIDENCE_PROTECT_R=0.70
XAUEX_SESSION_LOW_CONFIDENCE_PROTECT_LOCK_R=0.35
XAUEX_SESSION_HIGH_CONFIDENCE_PROTECT_R=1.00
XAUEX_SESSION_HIGH_CONFIDENCE_PROTECT_LOCK_R=0.25
XAUEX_MANUAL_COMMAND_PATH=/var/lib/xauex/manual_trade_cmd.json
XAUEX_MANUAL_COMMAND_LEDGER_PATH=/var/lib/xauex/manual_command_ids.json

# Maximum age for an upstream confirm_status (CONFIRMED/SKIP) read from
# cmd.json before the bot forces a re-confirmation. Defends against stale
# leftover confirms slipping through after news has started. Default 600s.
XAUEX_CONFIRM_MAX_AGE_SECONDS=600

# Feature-flag the pattern gate on the XAUEX entry path. When set to true
# the bot refuses to place an order unless an H1 pattern at a nearby HTF
# level supports the proposed direction. Lifetime data shows pattern=NONE
# trades net -$35 vs pattern-confirmed +$265 — strongly recommended once
# pattern hit rate has been validated in OBSERVE_ONLY mode for 5 trading
# days.
XAUEX_REQUIRE_PATTERN_MATCH=false

# Health / review output
XAUEX_WEEKLY_MARKDOWN_OUTPUT=/var/lib/xauex/weekly_review.md

# Optional analyst/report overrides (defaults to the repo LLM API settings)
XAUEX_ANALYST_MODEL=llama-3.1-8b-instant

# Optional signal-assurance overrides if the bot host also runs the signal pipeline
XAUEX_SIGNAL_PARSER_LLM_MODEL=openai/gpt-oss-120b
XAUEX_SIGNAL_DECISION_MODE=baseline
XAUEX_SIGNAL_DEBATE_ANALYST_MODEL=llama-3.1-8b-instant
XAUEX_SIGNAL_VALIDATOR_LLM_MODEL=llama-3.3-70b-versatile
XAUEX_SIGNAL_BRIEF_LLM_MODEL=llama-3.1-8b-instant
XAUEX_SIGNAL_DAILY_COST_CAP_USD=0.20
XAUEX_SIGNAL_ARCHIVE_DIR=/var/lib/xauex/signal_runs
XAUEX_SHADOW_TRIAL_DIR=/var/lib/xauex/shadow_trials
XAUEX_SHADOW_HOLD_BAND_USD=2.0
XAUEX_SHADOW_REPORT_LOOKBACK_DAYS=7
XAUEX_SHADOW_REPORT_MIN_HISTORY_DAYS=6
XAUEX_SIGNAL_CME_FEDWATCH_API_URL=
XAUEX_SIGNAL_CME_FEDWATCH_API_KEY=
XAUEX_SIGNAL_CME_FEDWATCH_API_KEY_HEADER=Authorization
